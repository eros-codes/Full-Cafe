# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/roof?schema=public"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Public address of the site. In production this MUST be the real https address:
# the payment gateway sends customers back to APP_URL/api/payments/callback.
APP_URL="http://localhost:3000"

# Two different long random strings (32+ characters each). Required in production.
JWT_SECRET="change-me-user-secret-at-least-32-characters"
ADMIN_JWT_SECRET="change-me-admin-secret-at-least-32-characters"

# ─── First admin account (created by `npm run db:seed`) ──────────────────────
# This account gets the DEVELOPER role: the only role that can edit the floor map.
SEED_ADMIN_USERNAME="developer"
SEED_ADMIN_PASSWORD="choose-a-strong-password"
SEED_ADMIN_NAME="Developer"

# ─── SMS ─────────────────────────────────────────────────────────────────────
# "console" prints messages (and OTP codes) to the server log. Not allowed in production.
SMS_MODE="console"

# ─── Payment (Zarinpal) ──────────────────────────────────────────────────────
# "sandbox" for testing, "live" in production (required when NODE_ENV=production).
PAYMENT_MODE="sandbox"
ZARINPAL_MERCHANT_ID=""

# ─── Tests only ──────────────────────────────────────────────────────────────
# A SEPARATE database whose name contains "test". It is wiped on every `npm test`.
# TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/roof_test?schema=public"
