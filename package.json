{
	"name": "roof-cafe",
	"version": "1.0.0",
	"description": "Roof café website: menu, reviews, table reservation with live floor map, payments and one admin panel. Express + Prisma + PostgreSQL (TypeScript) backend, React + Vite frontend.",
	"main": "dist/server/server.js",
	"type": "module",
	"scripts": {
		"dev": "tsx watch --clear-screen=false src/server.ts",
		"build": "prisma generate && tsc -p tsconfig.build.json && vite build",
		"build:client": "vite build",
		"start": "node dist/server/server.js",
		"typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json",
		"test": "node --import tsx --test \"test/**/*.test.ts\"",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:deploy": "prisma migrate deploy",
		"prisma:studio": "prisma studio",
		"db:seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@prisma/client": "^5.22.0",
		"bcryptjs": "^2.4.3",
		"cookie-parser": "^1.4.7",
		"dotenv": "^16.4.7",
		"express": "^4.21.2",
		"express-rate-limit": "^7.4.1",
		"helmet": "^8.0.0",
		"jsonwebtoken": "^9.0.2",
		"morgan": "^1.10.0",
		"multer": "^2.0.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/cookie-parser": "^1.4.7",
		"@types/express": "^4.17.21",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/morgan": "^1.9.9",
		"@types/multer": "^1.4.12",
		"@types/node": "^22.9.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^4.7.0",
		"prisma": "^5.22.0",
		"tsx": "^4.19.2",
		"typescript": "^5.6.3",
		"vite": "^6.4.4"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	}
}
